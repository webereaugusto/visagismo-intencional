---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { whatsappLink } from '../config/site';

const waLink = whatsappLink('Olá, não encontrei uma página no site e gostaria de agendar uma consultoria de visagismo');
---

<Layout
  title="Página não encontrada | Visagismo Intencional"
  description="A página que você procurou não existe ou mudou de endereço."
  path="/404/"
  noindex
>
  <Header />
  <main id="conteudo-principal">
    <section class="min-h-[70vh] flex items-center pt-32 pb-20 bg-dark">
      <div class="max-w-2xl mx-auto px-5 md:px-6 text-center">
        <p class="font-montserrat text-gold tracking-[0.3em] uppercase text-sm mb-4">Erro 404</p>
        <h1 class="font-playfair text-4xl md:text-5xl text-white font-medium mb-6">Página não encontrada</h1>
        <p class="font-montserrat text-gray-light text-lg leading-relaxed mb-10">
          O endereço pode ter mudado. Volte para a página inicial ou fale direto com a gente pelo WhatsApp.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="font-montserrat inline-flex justify-center px-8 py-4 bg-gold text-dark font-semibold rounded-full hover:opacity-90 transition-opacity">
            Ir para a página inicial
          </a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="font-montserrat inline-flex justify-center px-8 py-4 border border-gold text-gold font-semibold rounded-full hover:bg-gold/10 transition-colors">
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
